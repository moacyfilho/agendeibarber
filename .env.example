# ============================
# BANCO DE DADOS (SUPABASE)
# ============================
# Connection Pooler (Transaction mode) - usado pelo app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection - usado para migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ============================
# AUTENTICAÇÃO (NEXTAUTH)
# ============================
AUTH_SECRET="gere-uma-string-aleatoria-aqui"  # Execute: openssl rand -base64 32

# ============================
# EMAIL (RESEND) - Opcional
# ============================
# RESEND_API_KEY="re_xxxxxxxxx"

# ============================
# PAGAMENTOS (STRIPE) - Opcional
# ============================
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxx"
